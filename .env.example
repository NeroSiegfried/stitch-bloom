# PostgreSQL (Neon, Supabase Postgres, or another hosted PostgreSQL database).
# Production points at the primary branch. Preview and Development point at a
# separate sandbox branch so preview deployments and their owner accounts never
# touch live orders, catalogue or customers. See "Sandbox branch" in the README.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to "disable" only for a local PostgreSQL instance without TLS.
DATABASE_SSL=require

# Authentication. Generate a random value with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional separate key for HMAC-protecting one-time codes. If omitted,
# SESSION_SECRET is used. Generate with: openssl rand -base64 48
OTP_SECRET=replace-with-at-least-32-random-characters

# Transactional account email through Resend. Email verification and password
# recovery activate only when both values are set; existing sign-in remains
# available if the email provider has not been connected yet.
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=The Stitch Bloom <accounts@thestitchbloom.com>

# Dormant social sign-in. Controls remain unrendered until credentials are
# complete and this explicit switch is true.
AUTH_OAUTH_UI_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Use literal \n separators when entering a multiline key in Vercel.
APPLE_PRIVATE_KEY=

# Secures Vercel's daily pending-payment reconciliation endpoint. Generate with:
# openssl rand -base64 32
CRON_SECRET=replace-with-a-random-cron-secret

# Optional. Active Paystack attempts older than this are closed locally as
# expired after verification. A later gateway success still enters owner review.
PAYMENT_ATTEMPT_TTL_HOURS=24

# Owner identity. This list is authoritative for the database it is run against:
# every address named here is promoted and any other admin is demoted, so an
# owner transfer stays explicit. Comma-separate to grant several people access.
# Create each account through the storefront first, then run npm run admin:promote.
# Production and the sandbox branch each keep their own list.
ADMIN_EMAIL=owner@example.com

# Paystack keys. Set the sk_test_/pk_test_ pair on Preview and Development, and
# the sk_live_/pk_live_ pair on Production only. The deployment reads its mode
# from the key prefix: a live key is refused on Preview and Development, and the
# storefront shows a test-mode notice whenever the public key is a test key.
PAYSTACK_SECRET_KEY=sk_test_replace_me
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Canonical deployed origin, Production only. Do not include a trailing slash.
# Leave this unset on Preview so each preview deployment sends Paystack callbacks
# back to its own URL instead of to the live shop.
APP_URL=https://thestitchbloom.com
